# ==============================================================================
# PAHAD.co Production Environment Configuration
# ==============================================================================

# Supabase Production Backend (Required for live deployment)
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key...

# Supabase Service Role Key (Keep private, never expose to frontend)
# Used only by backend administrative maintenance scripts
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Local Server Configuration (Optional / Transition Backend)
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://pahad.co
JWT_SECRET=your_production_jwt_secret_must_be_at_least_32_characters_long

# Local Fallback Admin Credentials (For local offline testing)
ADMIN_USERNAME=admin@pahad.co
ADMIN_PASSWORD=change_this_to_strong_secure_password
DB_PATH=./server/data/pahad.sqlite
